# Render Web Service > Environment에 입력. 이 파일은 자동으로 로드하지 않습니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 로 생성
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# node scripts/hash-password.mjs 로 생성. 평문 비밀번호가 아니라 bcrypt 해시 입력
WORKSPACE_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
